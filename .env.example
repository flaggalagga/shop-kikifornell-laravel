# ---------------------------------------------------------------------------
# Kiki Fornell shop. Copy to .env and fill in.
# Local development: the defaults below work as-is (SQLite, emails in the log).
# Production on OVH: see README.md, section "Install on OVH".
# ---------------------------------------------------------------------------

APP_NAME="Kiki Fornell"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: https://shop.kikifornell.art
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Europe/Paris

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Production: warning
LOG_LEVEL=debug

# Local: sqlite. Production (OVH): mysql with the database created in the OVH panel.
DB_CONNECTION=sqlite
# DB_HOST=xxxxx.mysql.db
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: true (cookies only over HTTPS)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# OVH shared hosting cannot run queue workers: everything runs immediately.
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Local: log (emails are written to storage/logs/laravel.log).
# Production with an OVH mailbox: smtp, ssl0.ovh.net, port 465, scheme smtps.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=ssl0.ovh.net
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@kikifornell.art"
MAIL_FROM_NAME="${APP_NAME}"

# --- Shop -------------------------------------------------------------------
SHOP_CONTACT_EMAIL=contact@kikifornell.art
SHOP_LEGAL_NAME="Kiki Fornell — Ekaterina Fornell EI"
SHOP_LEGAL_ADDRESS="[adresse], 74400 Chamonix-Mont-Blanc, France"
SHOP_SIRET="[SIRET]"
SHOP_VAT_NOTE="TVA non applicable, art. 293 B du CGI"
# SHOP_VAT_NUMBER=
SHOP_ORDER_PREFIX=KF

# Shipping prices in cents (TODO: confirm with Kiki).
SHIPPING_FRANCE_CENTS=900
SHIPPING_EU_CENTS=1900
SHIPPING_INTERNATIONAL_CENTS=3500

# --- Stripe -------------------------------------------------------------------
# Test keys (sk_test_…) until launch. Dashboard > Developers > API keys.
STRIPE_SECRET=
# Dashboard > Developers > Webhooks > your endpoint > Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=
# Set to true once a terms-of-service URL is saved in Stripe > Settings > Public details.
STRIPE_REQUIRE_TERMS=false
# For test mode: https://dashboard.stripe.com/test
STRIPE_DASHBOARD_URL=https://dashboard.stripe.com

# --- Admin --------------------------------------------------------------------
# Every admin must set up an authenticator app (recommended: keep true).
ADMIN_REQUIRE_MFA=true

# --- Social links in the footer (optional) ------------------------------------
# SOCIAL_INSTAGRAM=https://www.instagram.com/…
# SOCIAL_PINTEREST=
# SOCIAL_FACEBOOK=

# --- Old PrestaShop database, only for `php artisan shop:import-prestashop` ---
# PRESTASHOP_DB_HOST=
# PRESTASHOP_DB_DATABASE=
# PRESTASHOP_DB_USERNAME=
# PRESTASHOP_DB_PASSWORD=
